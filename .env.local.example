# Copy this file to .env.local and fill in your Supabase project values
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# Resend (email delivery)
RESEND_API_KEY=re_your_resend_api_key_here

# Email sender addresses — use purpose-specific prefixes on your verified domain
SENDER_EMAIL_ONBOARDING=onboarding@mail.yourdomain.com  # Welcome emails for new accounts
SENDER_EMAIL_SECURITY=security@mail.yourdomain.com      # OTP codes, 2FA verification
SENDER_EMAIL_INVITES=invites@mail.yourdomain.com        # Team invitation emails
SENDER_EMAIL_NOREPLY=noreply@mail.yourdomain.com        # Password resets, transactional

# Cron job auth
CRON_SECRET=your_cron_secret_here
